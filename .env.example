# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real secrets, family names, or tokens to this repo.

# Required - your Anthropic API key
ANTHROPIC_API_KEY=your-key-here

# Required for the pilot - signs the session cookie that tracks which
# family is chatting. Any long random string works, e.g. generate one
# with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-string

# Required for per-family links (/f/<token>). A JSON object mapping a
# private, unguessable token to a human-readable family name. Keep the
# real version of this out of git - set it directly in Render's
# dashboard for the deployed pilot.
# Example:
# FAMILIES_JSON={"sunshine-42": "The Martinez Family", "brave-otter-7": "The Chen Family"}
FAMILIES_JSON={}

# Required to view /review (the session log page). Choose your own
# username/password - do not reuse a real password.
REVIEW_USERNAME=change-me
REVIEW_PASSWORD=change-me

# Optional - where the SQLite log file lives. Defaults to data.db in
# the project root if not set.
# DB_PATH=data.db
